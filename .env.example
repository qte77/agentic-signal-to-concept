# Copy to .env and fill in. Never commit .env itself.

# Required for complaint-miner's ProductHunt GraphQL v2 pass.
# Self-serve: create a PH account at https://www.producthunt.com/v2/oauth/applications, create an
# application there to get a developer_token (redirect_url field is required by the form but inert
# for this path — any placeholder works). UNVERIFIED FOR THIS USE CASE: ProductHunt's API docs state
# the API "must not be used for commercial purposes" without contacting hello@producthunt.com — not
# confirmed whether concept-mining for potential products counts; decide before relying on this token
# for anything beyond experimentation.
PRODUCTHUNT_API_TOKEN=

# Not used directly as an env var by build-pattern-scanner — it authenticates GitHub search calls via
# the already-logged-in `gh` CLI instead (see build-pattern-scanner.md step 1), since polyfetch's CLI
# can't attach an Authorization header. Confirmed live via `gh api rate_limit`: GitHub's *search* API
# (what this pipeline actually calls) is 10 req/min unauthenticated, 30 req/min authenticated — not
# the 5,000 req/hour figure, which is the separate core/REST API's limit and doesn't apply here.
GITHUB_TOKEN=
