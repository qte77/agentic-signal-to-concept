# Copy to .env and fill in. Never commit .env itself.

# Required for complaint-miner's ProductHunt GraphQL v2 pass.
# Self-serve: create a PH account, generate a developer_token from its API dashboard.
PRODUCTHUNT_API_TOKEN=

# Optional for build-pattern-scanner's GitHub pass. Unauthenticated GitHub API access works
# (60 req/hour); a token raises that to 5000/hour. A fine-grained PAT with no scopes (public-repo
# read only) is sufficient.
GITHUB_TOKEN=
